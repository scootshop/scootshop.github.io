RewriteEngine On
RewriteBase /api/

# Bloquea acceso directo a logs y archivos de configuración
<FilesMatch "\.(log|env|cfg|ini|bak|sql)$">
  Require all denied
</FilesMatch>

RewriteRule ^health$ index.php?route=health [L,QSA]
RewriteRule ^paypal/config$ index.php?route=paypal_config [L,QSA]
RewriteRule ^paypal/create-order$ index.php?route=paypal_create_order [L,QSA]
RewriteRule ^paypal/capture-order$ index.php?route=paypal_capture_order [L,QSA]
RewriteRule ^stripe/config$ index.php?route=stripe_config [L,QSA]
RewriteRule ^stripe/checkout$ index.php?route=stripe_checkout [L,QSA]
RewriteRule ^stripe/session-status$ index.php?route=stripe_session_status [L,QSA]
RewriteRule ^stripe/webhook$ index.php?route=stripe_webhook [L,QSA]

RewriteRule ^orders/create$ index.php?route=orders_create [L,QSA]
RewriteRule ^orders/manual-create$ index.php?route=manual_order_create [L,QSA]
RewriteRule ^orders/resume-payment$ index.php?route=orders_resume_payment [L,QSA]
RewriteRule ^orders/([A-Za-z0-9\-]+)$ index.php?route=orders_get&id=$1 [L,QSA]

RewriteRule ^admin/orders/list$ index.php?route=admin_orders_list [L,QSA]
RewriteRule ^admin/orders/([A-Za-z0-9\-]+)/status$ index.php?route=admin_status&id=$1 [L,QSA]
RewriteRule ^admin/orders/([A-Za-z0-9\-]+)/detail$ index.php?route=admin_order_detail&id=$1 [L,QSA]
RewriteRule ^admin/orders/([A-Za-z0-9\-]+)/notes$ index.php?route=admin_order_notes&id=$1 [L,QSA]
RewriteRule ^admin/orders/([A-Za-z0-9\-]+)/resend-paid-email$ index.php?route=admin_resend_paid_email&id=$1 [L,QSA]
RewriteRule ^admin/orders/([A-Za-z0-9\-]+)/delete$ index.php?route=admin_order_delete&id=$1 [L,QSA]
RewriteRule ^admin/orders/bulk-delete$ index.php?route=admin_orders_bulk_delete [L,QSA]
RewriteRule ^admin/dashboard$ index.php?route=admin_dashboard [L,QSA]

RewriteRule ^admin/bust-cache$ index.php?route=admin_bust_cache [L,QSA]
RewriteRule ^admin/products/list$ index.php?route=admin_products_list [L,QSA]
RewriteRule ^admin/product/stock$ index.php?route=admin_product_stock [L,QSA]
RewriteRule ^admin/product/price$ index.php?route=admin_product_price [L,QSA]

RewriteRule ^paypal/ipn$ index.php?route=paypal_ipn [L,QSA]
