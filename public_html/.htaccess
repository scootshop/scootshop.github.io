DirectoryIndex index.html index.php
RewriteEngine On
AddDefaultCharset UTF-8

# ──────────────────────────────────────────────
# Compresión GZIP
# ──────────────────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE application/xml application/xhtml+xml
  AddOutputFilterByType DEFLATE application/rss+xml application/atom+xml
  AddOutputFilterByType DEFLATE image/svg+xml
  AddOutputFilterByType DEFLATE font/ttf font/otf font/woff font/woff2
  AddOutputFilterByType DEFLATE application/font-woff application/font-woff2
  AddOutputFilterByType DEFLATE application/vnd.ms-fontobject
</IfModule>

# ──────────────────────────────────────────────
# Cache de navegador
# ──────────────────────────────────────────────
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"

  # HTML: cache corto (se revalida con asset-version)
  ExpiresByType text/html "access plus 0 seconds"

  # CSS / JS: cache largo (versionados con ?v=)
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"

  # Imágenes
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"

  # Fuentes
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/ttf "access plus 1 year"
  ExpiresByType application/font-woff "access plus 1 year"
  ExpiresByType application/font-woff2 "access plus 1 year"

  # JSON / Manifest dinámicos
  ExpiresByType application/json "access plus 0 seconds"
  ExpiresByType application/manifest+json "access plus 0 seconds"
</IfModule>

# Cache-Control headers
<IfModule mod_headers.c>
  # HTML: revalidar siempre, pero SIN no-store para permitir el bfcache (volver
  # atrás/adelante restaura la página y su posición de scroll al instante, sin
  # recargar). no-cache + must-revalidate garantiza contenido fresco en cargas reales.
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, must-revalidate, max-age=0"
    Header set Expires "0"
  </FilesMatch>

  # Assets versionados: cache largo
  <FilesMatch "\.(css|js|svg|woff|woff2|ttf|otf|eot)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Archivos dinámicos/bootstrap: sin cache persistente.
  # `product-overrides.js` lo escribe el PANEL: un precio cambiado tiene que verse ya,
  # así que no puede quedarse en la caché del navegador como el resto del JS.
  <FilesMatch "^(product-overrides\.js|asset-version\.json|index-head\.js|global-assets\.js|asset-sync\.js)$">
    Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  # `data/products.js` SÍ se guarda, pero se revalida siempre.
  # Estaba en el grupo de arriba desde cuando el panel lo reescribía con expresiones
  # regulares. Ya no: el panel escribe `product-overrides.js` y este fichero solo cambia
  # cuando una persona lo edita y despliega. Prohibir guardarlo costaba 121 KB (19,7 KB
  # comprimidos) en CADA vista de CADA página, porque lo carga el sitio entero. Con
  # `no-cache` el navegador lo guarda y pregunta en cada visita; el servidor responde
  # 304 con unos cientos de bytes salvo que haya cambiado de verdad.
  # Es la línea que peor escala: con cinco veces más productos serían ~100 KB por vista.
  <FilesMatch "^products\.js$">
    Header set Cache-Control "no-cache, must-revalidate, max-age=0"
    Header unset Pragma
    Header set Expires "0"
  </FilesMatch>

  # Manifest/PWA: evitar que Safari use manifiesto viejo
  <FilesMatch "^(site\.webmanifest|browserconfig\.xml)$">
    Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  # Imágenes: cache largo
  <FilesMatch "\.(jpg|jpeg|png|gif|webp|avif|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Seguridad
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  Header always set X-XSS-Protection "1; mode=block"
</IfModule>

# ──────────────────────────────────────────────
# Seguridad
# ──────────────────────────────────────────────

# Bloquea acceso directo a archivos .env y env (con o sin punto)
RewriteRule (^|/)\.env$ - [F,L,NC]
RewriteRule (^|/)\.env\..*$ - [F,L,NC]
RewriteRule (^|/)env$ - [F,L,NC]

# Bloquea config.php (solo index.php debe ser accesible en /api)
RewriteRule ^api/config\.php$ - [F,L,NC]

# Bloquea archivos de desarrollo local (server.ps1, server.py, router.php, deploy.py)
RewriteRule ^(server\.ps1|server\.py|router\.php|deploy\.py)$ - [F,L,NC]

# SEGURIDAD: deniega CUALQUIER archivo de código/dev/config/backup en todo el sitio.
# Cubre deploy.py, scripts/*.ps1, *.py, dumps .sql, logs, backups, docs .md, archivos comprimidos…
# NO incluye .php (api/index.php debe ejecutarse) ni .json (asset-version.json es público).
<FilesMatch "(?i)\.(py|ps1|psm1|sh|bash|zsh|sql|sqlite|db|bak|old|orig|save|swp|tmp|log|ini|cfg|conf|yml|yaml|toml|lock|md|zip|tar|gz|tgz|bz2|7z|rar)$">
  Require all denied
</FilesMatch>

# (Opcional) Fuerza HTTPS
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# /index.html -> /
RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
RewriteRule ^index\.html$ / [R=301,L]

# Fichas retiradas -> su equivalente vivo. Se retiran del servidor, pero la URL
# sigue indexada: sin esto quedaria un 404 y se pierde el enlace entrante.
RewriteRule ^patinetes/series-k/m41-armored/?$ /patinetes/ecoxtrem/m41-armored-one/ [R=301,L]
# El manillar KRSEC se sustituyo por el WAKE WKHB01 (mismo hueco de catalogo).
RewriteRule ^accesorios/manillar-krsec/?$ /accesorios/manillar-wake/ [R=301,L]

# Las paginas donde se compararon los diseños de filtros y de la placa de marca
# elegida (31 ago 2026). Ya se
# eligio, asi que deja de existir; sigue en el servidor porque deploy.py no borra
# en remoto, y esta regla es lo que la retira de la web.
RewriteRule ^pruebas-filtros(\.html)?/?$ / [R=301,L]
RewriteRule ^pruebas-marcas(\.html)?/?$ / [R=301,L]
RewriteRule ^pruebas-iconos(\.html)?/?$ / [R=301,L]

# Baja 30 ago 2026: patinetes SIN homologar, que no se pueden vender para circular
# en España. Los cuatro KUKIRIN son de los doce que el distribuidor no homologa y
# ademas pasan de 50 km/h; el JOYOR C10 tiene su gemelo homologado (C10 DGT), asi
# que ese va derecho a el. Los KUKIRIN van a su alternativa HOMOLOGADA mas cercana
# —quien llegaba buscando un G4 encuentra un G3 Pro que si puede circular—, y no al
# listado de la serie: /patinetes/series-k/ es una carpeta sin pagina y devuelve 403.
RewriteRule ^patinetes/joyor/c10/?$ /patinetes/joyor/c10-dgt/ [R=301,L]
RewriteRule ^patinetes/series-k/g2-master/?$ /patinetes/series-k/g2-max/ [R=301,L]
RewriteRule ^patinetes/series-k/g2-ultra/?$ /patinetes/series-k/g2-max/ [R=301,L]
RewriteRule ^patinetes/series-k/g4-max/?$ /patinetes/series-k/g3-pro/ [R=301,L]
RewriteRule ^patinetes/series-k/g4/?$ /patinetes/series-k/g3-pro/ [R=301,L]

# Baja 9 sep 2026: se recorta la gama JOYOR. Ocho SIN homologar (los ocho mas caros)
# y uno homologado, el S-PRO, por decision comercial. Quedan ocho JOYOR: tres
# homologados (T6D, Y10 DGT, C10 DGT) y cinco sin homologar de gama baja.
# El T6 va derecho a su gemelo homologado, el T6D, igual que se hizo con el C10.
# El resto va al Y10 DGT, que es el JOYOR homologado mas potente que sobrevive
# (800 W, 100 km): quien buscaba un S8 o un E6-S encuentra algo que SI puede circular.
# No se manda a /patinetes/joyor/ porque es una carpeta sin pagina y devuelve 403.
RewriteRule ^patinetes/joyor/t6/?$ /patinetes/joyor/t6d/ [R=301,L]
RewriteRule ^patinetes/joyor/s8/?$ /patinetes/joyor/y10-dgt/ [R=301,L]
RewriteRule ^patinetes/joyor/s8e/?$ /patinetes/joyor/y10-dgt/ [R=301,L]
RewriteRule ^patinetes/joyor/s8-s-z/?$ /patinetes/joyor/y10-dgt/ [R=301,L]
RewriteRule ^patinetes/joyor/s10-s-z/?$ /patinetes/joyor/y10-dgt/ [R=301,L]
RewriteRule ^patinetes/joyor/luxerider/?$ /patinetes/joyor/y10-dgt/ [R=301,L]
RewriteRule ^patinetes/joyor/e6-s/?$ /patinetes/joyor/y10-dgt/ [R=301,L]
RewriteRule ^patinetes/joyor/s-pro/?$ /patinetes/joyor/y10-dgt/ [R=301,L]
RewriteRule ^patinetes/series-gt/t10-dual/?$ /patinetes/joyor/y10-dgt/ [R=301,L]

# /algo.html -> /algo
RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
RewriteRule ^ %1 [R=301,L]

# /algo  o  /algo/  -> sirve algo.html si existe
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)/?$ $1.html [L]

# Evita duplicados con barra final (si no es un directorio real)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.+)/$ $1 [R=301,L]
